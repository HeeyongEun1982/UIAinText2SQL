{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/query-layout-4.0.json",
  "title": "Simple Unified BIF/SIF Query Layout",
  "description": "One flat SQL layout. A field is linked once and SQL clauses reference its id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "sources", "fields", "select", "predicates", "where", "group_by", "having_predicates", "having", "order_by", "joins", "distinct", "limit"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "phase": {"enum": ["bif", "sif"]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "select": {"$ref": "#/$defs/idList"},
    "predicates": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
    "where": {"type": ["string", "null"]},
    "group_by": {"$ref": "#/$defs/idList"},
    "having_predicates": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
    "having": {"type": ["string", "null"]},
    "order_by": {"type": "array", "items": {"$ref": "#/$defs/order"}},
    "joins": {"type": "array", "items": {"$ref": "#/$defs/join"}},
    "distinct": {"type": "boolean"},
    "limit": {"type": ["integer", "null"], "minimum": 1}
  },
  "$defs": {
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "value": {
      "oneOf": [
        {"type": "null"}, {"type": "string"}, {"type": "number"}, {"type": "boolean"},
        {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "table"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "table": {"type": ["string", "null"]}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "source", "column", "expression", "aggregate", "distinct"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "column": {"type": ["string", "null"]},
        "expression": {"type": ["string", "null"]},
        "aggregate": {"enum": ["count", "sum", "avg", "min", "max", null]},
        "distinct": {"type": "boolean"}
      }
    },
    "predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "field", "role", "operator", "value"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "operator": {"type": ["string", "null"]},
        "value": {"$ref": "#/$defs/value"}
      }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "aggregate", "direction"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "aggregate": {"enum": ["count", "sum", "avg", "min", "max", null]},
        "direction": {"enum": ["asc", "desc"]}
      }
    },
    "join": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "type", "left_source", "left_column", "right_source", "right_column"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "type": {"enum": ["inner", "left", "right", "full", "cross", null]},
        "left_source": {"type": ["string", "null"]},
        "left_column": {"type": ["string", "null"]},
        "right_source": {"type": ["string", "null"]},
        "right_column": {"type": ["string", "null"]}
      }
    }
  }
}
