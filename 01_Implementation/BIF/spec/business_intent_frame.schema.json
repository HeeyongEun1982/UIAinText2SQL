{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/business-intent-frame-1.0.json",
  "title": "Business Intent Frame",
  "description": "User-facing, schema-independent analytical intent contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "source",
    "lifecycle",
    "decision_objective",
    "target_population",
    "metrics",
    "calculation",
    "granularity",
    "scope",
    "time_basis",
    "comparisons",
    "output_expectation",
    "assumptions",
    "field_states",
    "readiness"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "frame_id": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "decision_objective": {"$ref": "#/$defs/decisionObjective"},
    "target_population": {"$ref": "#/$defs/targetPopulation"},
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric"}
    },
    "calculation": {"$ref": "#/$defs/calculation"},
    "granularity": {"$ref": "#/$defs/granularity"},
    "scope": {"$ref": "#/$defs/scope"},
    "time_basis": {"$ref": "#/$defs/timeBasis"},
    "comparisons": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "output_expectation": {"$ref": "#/$defs/outputExpectation"},
    "slot_layout": {"$ref": "#/$defs/slotLayout"},
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    },
    "field_states": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldState"}
    },
    "readiness": {"$ref": "#/$defs/readiness"}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "db_id", "question"],
      "properties": {
        "question_id": {"type": ["integer", "string"]},
        "db_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "revision"],
      "properties": {
        "state": {
          "enum": ["draft", "awaiting_confirmation", "confirmed", "corrected", "blocked"]
        },
        "revision": {"type": "integer", "minimum": 1},
        "confirmed_by": {"type": ["string", "null"]},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "decisionObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "intent_types"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "intent_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "retrieve", "count", "summarize", "derive", "compare", "rank",
              "select_extreme", "filter", "test_existence", "trend", "custom"
            ]
          }
        }
      }
    },
    "targetPopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_entity", "entity_description", "inclusion_conditions", "inclusion_logic", "exclusion_conditions", "exclusion_logic"],
      "properties": {
        "primary_entity": {"type": "string", "minLength": 1},
        "entity_description": {"type": "string", "minLength": 1},
        "inclusion_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        },
        "inclusion_logic": {"$ref": "#/$defs/conditionLogic"},
        "exclusion_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        },
        "exclusion_logic": {"$ref": "#/$defs/conditionLogic"}
      }
    },
    "conditionLogic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "condition_refs", "groups"],
      "properties": {
        "operator": {"enum": ["all_of", "any_of", "none_of"]},
        "condition_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/conditionLogic"}
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "semantic_dimension", "subject", "operator", "value_mode", "set_relation", "value", "description"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "semantic_dimension": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Schema-independent business dimension. Null defers dimension resolution to SIF."
        },
        "source_text": {"type": ["string", "null"]},
        "business_concept": {"type": ["string", "null"]},
        "semantic_dimension_status": {
          "enum": ["explicit", "user_confirmed", "inferred_non_material", "deferred_to_sif", "unresolved_user"]
        },
        "grounding_requirement": {"enum": ["none", "schema", "user"]},
        "state": {
          "enum": ["explicit", "user_confirmed", "inferred_non_material", "deferred_to_sif", "unresolved_user", "unsupported"]
        },
        "subject": {"type": "string", "minLength": 1},
        "operator": {
          "enum": [
            "equals", "not_equals", "greater_than", "greater_or_equal",
            "less_than", "less_or_equal", "between", "in", "not_in",
            "contains", "starts_with", "ends_with", "is_missing",
            "is_not_missing", "exists", "not_exists", "custom"
          ]
        },
        "value_mode": {"enum": ["scalar", "range", "set", "none", "custom"]},
        "set_relation": {"enum": ["not_applicable", "any_of", "all_of"]},
        "value": {},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "name", "definition", "measure_kind", "unit"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "measure_kind": {"enum": ["attribute", "count", "derived", "indicator", "custom"]},
        "unit": {"type": ["string", "null"]},
        "validation_semantics": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "rule"],
          "properties": {
            "status": {"enum": ["explicit", "user_confirmed", "deferred_to_sif", "not_applicable"]},
            "rule": {"type": ["string", "null"]}
          }
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "null_handling", "duplicate_handling"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {"$ref": "#/$defs/calculationStep"}
        },
        "null_handling": {"type": ["string", "null"]},
        "duplicate_handling": {"type": ["string", "null"]}
      }
    },
    "calculationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "operation", "description", "input_refs", "output_ref", "method"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "operation": {
          "enum": [
            "retrieve", "filter", "derive", "aggregate", "compare", "rank",
            "select", "set_combine", "existence", "custom"
          ]
        },
        "description": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string"}},
        "output_ref": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "granularity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_unit", "output_unit", "dimensions"],
      "properties": {
        "input_unit": {"type": "string", "minLength": 1},
        "output_unit": {"type": "string", "minLength": 1},
        "dimensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grouping_dimensions", "selections"],
      "properties": {
        "grouping_dimensions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "selections": {
          "type": "array",
          "items": {"$ref": "#/$defs/selection"}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_id", "mode", "target_ref", "within_dimensions", "n", "tie_policy"],
      "properties": {
        "selection_id": {"type": "string", "minLength": 1},
        "mode": {
          "enum": [
            "minimum", "maximum", "top_n", "bottom_n", "rank", "threshold",
            "latest", "earliest", "all_matching", "custom"
          ]
        },
        "target_ref": {"type": "string", "minLength": 1},
        "within_dimensions": {"type": "array", "items": {"type": "string"}},
        "n": {"type": ["integer", "null"], "minimum": 1},
        "tie_policy": {"enum": ["include_all", "return_exact_n", "first_only", "not_applicable", "unresolved"]}
      }
    },
    "timeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "description", "periods", "temporal_semantics", "cumulative"],
      "properties": {
        "mode": {
          "enum": [
            "not_applicable", "point_in_time", "fixed_period", "relative_period",
            "latest", "earliest", "recurring", "custom"
          ]
        },
        "description": {"type": ["string", "null"]},
        "periods": {"type": "array", "items": {"$ref": "#/$defs/period"}},
        "temporal_semantics": {
          "enum": ["not_applicable", "calendar_period", "rolling_period", "snapshot", "event_time", "custom"]
        },
        "cumulative": {"type": ["boolean", "null"]}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "grain"],
      "properties": {
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "grain": {"enum": ["instant", "day", "week", "month", "quarter", "year", "season", "custom"]}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison_id", "type", "left", "right", "direction", "output_ref"],
      "properties": {
        "comparison_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["difference", "absolute_difference", "ratio", "percentage", "percentage_change", "ordering", "equality", "custom"]},
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "minLength": 1},
        "output_ref": {"type": "string", "minLength": 1}
      }
    },
    "outputExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "fields", "ordering", "limit", "include_supporting_values"],
      "properties": {
        "shape": {
          "enum": ["scalar", "single_row", "detail_list", "grouped_table", "ranked_list", "time_series", "boolean", "custom"]
        },
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outputField"}},
        "ordering": {"type": "array", "items": {"$ref": "#/$defs/outputOrdering"}},
        "limit": {"type": ["integer", "null"], "minimum": 1},
        "include_supporting_values": {"type": "boolean"}
      }
    },
    "outputField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "label", "semantic_ref", "value_multiplicity", "coverage", "presentation"],
      "properties": {
        "field_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "semantic_ref": {"type": "string", "minLength": 1},
        "source_text": {"type": ["string", "null"]},
        "requested": {"type": "boolean"},
        "value_multiplicity": {"enum": ["single", "multiple", "unresolved"]},
        "coverage": {"enum": ["one", "all_requested", "all_available", "unresolved", "not_applicable"]},
        "presentation": {
          "enum": ["single_column", "separate_columns", "repeated_rows", "collection", "unresolved"],
          "description": "How multiple values of this business field must appear in the result. This is user-facing output intent, not a physical column choice."
        }
      }
    },
    "outputOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_ref", "direction"],
      "properties": {
        "semantic_ref": {"type": "string", "minLength": 1},
        "direction": {"enum": ["ascending", "descending"]}
      }
    },
    "slotLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_version", "source_cqd_hash", "slots", "coverage"],
      "properties": {
        "layout_version": {"const": "2.0"},
        "source_cqd_hash": {"type": ["string", "null"]},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/semanticSlot"}
        },
        "coverage": {
          "type": "array",
          "items": {"$ref": "#/$defs/slotCoverage"}
        }
      }
    },
    "semanticSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id", "role", "concept", "operation", "semantic_payload",
        "constraints", "extensions", "source_refs", "source_spans",
        "decision_refs", "legacy_refs", "state"
      ],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "role": {
          "enum": [
            "objective", "population", "filter", "output", "group",
            "aggregate", "calculation", "selection", "time", "comparison",
            "scope", "join", "order", "limit", "logic", "grounding"
          ]
        },
        "concept": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "description"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "operation": {
          "enum": [
            "retrieve", "include", "exclude", "filter", "group", "aggregate",
            "calculate", "select", "compare", "sort", "limit", "relate",
            "ground", "custom"
          ]
        },
        "semantic_payload": {"type": "object"},
        "constraints": {
          "type": "array", "items": {"$ref": "#/$defs/slotConstraint"}
        },
        "extensions": {
          "type": "array", "items": {"$ref": "#/$defs/slotExtension"}
        },
        "source_refs": {"$ref": "#/$defs/stringSet"},
        "source_spans": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision_refs": {"$ref": "#/$defs/stringSet"},
        "legacy_refs": {"$ref": "#/$defs/stringSet"},
        "state": {"enum": ["pending_grounding", "grounded", "clarification_required", "unsupported"]}
      }
    },
    "slotConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "type", "value", "description", "source_ref"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "relation", "value", "membership", "range", "pattern", "polarity",
            "distinctness", "null_handling", "multiplicity", "presentation",
            "temporal", "tie_policy", "validity", "boolean_attachment",
            "set_relation", "scope", "custom"
          ]
        },
        "value": {},
        "description": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "slotExtension": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "expected_effect", "origin", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "expected_effect": {"enum": ["output", "filter", "group", "aggregate", "join", "order", "calculation", "other"]},
        "origin": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "grounded", "clarification_required", "unsupported"]}
      }
    },
    "slotCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_ref", "slot_ids", "status"],
      "properties": {
        "requirement_ref": {"type": "string", "minLength": 1},
        "slot_ids": {"$ref": "#/$defs/stringSet"},
        "status": {"enum": ["represented", "deferred", "unsupported"]}
      }
    },
    "stringSet": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "description", "material", "status", "affected_paths"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "material": {"type": "boolean"},
        "status": {"enum": ["requires_confirmation", "confirmed", "corrected", "rejected", "not_applicable"]},
        "affected_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fieldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "state", "material", "note"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "state": {
          "enum": ["explicit", "inferred", "defaulted", "user_confirmed", "user_corrected", "unresolved", "not_applicable"]
        },
        "material": {"type": "boolean"},
        "note": {"type": ["string", "null"]}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blocking_paths", "reason"],
      "properties": {
        "state": {"enum": ["ready", "needs_confirmation", "needs_information", "unsupported", "blocked"]},
        "blocking_paths": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
